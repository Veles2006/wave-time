<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WaveTime" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>

        <!-- Background / Surface -->
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
<!--        <item name="colorBackground">@color/screen_bg</item>-->
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Control color: checkbox, radio, switch, selected state -->
        <item name="colorControlActivated">@color/primary</item>

        <!-- Status bar / Navigation bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Light mode: icon status bar màu tối -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Vì mình tự làm values-night rồi, không cần Android tự ép màu -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>


    </style>

    <style name="Theme.WaveTime" parent="Base.Theme.WaveTime" />
</resources>