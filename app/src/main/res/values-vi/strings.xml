    <string name="accessibility_info">
        Wave Time sử dụng Dịch vụ Trợ năng của Android để nhận biết tên gói của ứng dụng hiện đang
        hiển thị trên màn hình. Thông tin này giúp Wave Time xác định và chặn những ứng dụng bạn
        đã chọn khi chế độ chặn đang hoạt động.\n\nWave Time không đọc nội dung màn hình, tin nhắn,
        mật khẩu hoặc nội dung bạn nhập. Thông tin về ứng dụng đang hiển thị chỉ được xử lý trên
        thiết bị, không được gửi đến máy chủ và không được chia sẻ với bên thứ ba.
    </string>
    <string name="accessibility_instruction">
        Cách bật: nhấn nút bên dưới → mở Trợ năng → chọn Ứng dụng đã tải xuống hoặc Ứng dụng đã
        cài đặt → Wave Time → bật công tắc ở trên cùng.
    </string>
