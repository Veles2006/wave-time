<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.WaveTime" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>

        <!-- Background / Surface -->
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
<!--        <item name="colorBackground">@color/screen_bg</item>-->
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Control color -->
        <item name="colorControlActivated">@color/primary</item>

        <!-- Status bar / Navigation bar -->
        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:navigationBarColor">@color/screen_bg</item>

        <!-- Dark mode: icon status bar màu sáng -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

    </style>

    <style name="Theme.WaveTime" parent="Base.Theme.WaveTime" />

</resources>