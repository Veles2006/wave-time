<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBlocks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/ivEmptyBlock"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_lock_solid_full"
        android:layout_marginEnd="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:tint="@color/text_secondary"
        app:layout_constraintTop_toTopOf="@id/tvEmptyBlock"
        app:layout_constraintBottom_toBottomOf="@id/tvEmptyBlock"
        app:layout_constraintStart_toStartOf="@id/tvEmptyBlock" />

    <TextView
        android:id="@+id/tvEmptyBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="400dp"
        android:layout_marginTop="32dp"
        android:paddingStart="52dp"
        android:paddingEnd="0dp"
        android:text="@string/no_blocks_yet"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAccessibilityInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxWidth="400dp"
        android:layout_marginTop="24dp"
        android:text="@string/accessibility_info"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAccessibilityInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxWidth="400dp"
        android:layout_marginTop="10dp"
        android:text="@string/accessibility_instruction"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAccessibilityInfo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenAccessibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open_accessibility_settings"
        android:textSize="16sp"
        android:backgroundTint="@color/primary"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/tvAccessibilityInstruction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btnCreateBlock"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:padding="12dp"
        android:src="@drawable/ic_plus_solid_full"
        android:scaleType="centerInside"
        app:tint="@color/on_primary"
        android:background="@drawable/bg_primary_blue_circle"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Create Block"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="20dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>