<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="50dp"
        android:background="@color/primary"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_left_solid_full"
            app:tint="@color/on_primary"
            android:contentDescription="@string/back_task_list" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="0dp"
            android:textColor="@color/on_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="@string/create_task" />

        <ImageButton
            android:id="@+id/btnSuccess"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_check_solid_full"
            app:tint="@color/on_primary"
            android:background="@android:color/transparent"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:contentDescription="@string/btn_task_created_successfully" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="56dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_section_rounded_12"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvBasicTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/tittle_basic"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:paddingVertical="4dp"
                        app:layout_constraintEnd_toStartOf="@id/btnBasicQuestion"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageButton
                        android:id="@+id/btnBasicQuestion"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_light_blue_circle"
                        android:contentDescription="@string/btn_basic_question"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_question_solid_full"
                        app:layout_constraintBottom_toBottomOf="@id/tvBasicTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvBasicTitle"
                        app:tint="@color/on_primary"
                        tools:ignore="TouchTargetSizeCheck" />

                    <View
                        android:id="@+id/basicDivider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/divider"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvBasicTitle" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTaskName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/til_task_name"
                        app:boxBackgroundColor="@color/text_field_bg"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/text_field_box_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/text_field_box_stroke"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/basicDivider">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTaskName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:imeOptions="actionNone"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="1"
                            android:singleLine="false"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTaskDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/til_task_description"
                        app:boxBackgroundColor="@color/text_field_bg"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/text_field_box_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/text_field_box_stroke"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tilTaskName">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTaskDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:imeOptions="actionNone"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="1"
                            android:singleLine="false"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_section_rounded_12"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvConfigTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/title_config"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:paddingVertical="4dp"
                        app:layout_constraintEnd_toStartOf="@id/btnConfigQuestion"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageButton
                        android:id="@+id/btnConfigQuestion"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="2dp"
                        android:background="@drawable/bg_light_blue_circle"
                        android:contentDescription="@string/btn_config_question"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_question_solid_full"
                        app:layout_constraintBottom_toBottomOf="@id/tvConfigTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvConfigTitle"
                        app:tint="@color/on_primary" />

                    <View
                        android:id="@+id/configDivider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/divider"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvConfigTitle" />

                    <TextView
                        android:id="@+id/tvDifficultyLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:includeFontPadding="false"
                        android:text="@string/difficulty"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/configDivider" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderDifficulty"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:value="1"
                        android:valueFrom="1"
                        android:valueTo="8"
                        android:stepSize="1"
                        app:haloRadius="14dp"
                        app:labelBehavior="withinBounds"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvDifficultyLabel"
                        app:thumbColor="@color/primary"
                        app:thumbRadius="10dp"
                        app:tickColorActive="@color/primary"
                        app:tickColorInactive="@color/divider"
                        app:trackColorActive="@color/primary"
                        app:trackColorInactive="@color/divider"
                        app:trackHeight="6dp" />

                    <TextView
                        android:id="@+id/tvTaskTypeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:includeFontPadding="false"
                        android:text="@string/title_task_type"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/sliderDifficulty" />

                    <RadioGroup
                        android:id="@+id/rgTaskType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_surface_rounded_12"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTaskTypeLabel">

                        <RadioButton
                            android:id="@+id/rbDefaultType"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:buttonTint="@color/primary"
                            android:checked="true"
                            android:gravity="center_vertical"
                            android:text="@string/default_text"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rbDailyType"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="12dp"
                            android:buttonTint="@color/primary"
                            android:gravity="center_vertical"
                            android:text="@string/daily"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:visibility="gone" />

                    </RadioGroup>

                    <TextView
                        android:id="@+id/tvCompleteModeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:includeFontPadding="false"
                        android:text="@string/title_complete_mode"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/rgTaskType" />

                    <RadioGroup
                        android:id="@+id/rgCompleteMode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_surface_rounded_12"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvCompleteModeLabel">

                        <RadioButton
                            android:id="@+id/rbTapMode"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:buttonTint="@color/primary"
                            android:checked="true"
                            android:gravity="center_vertical"
                            android:text="@string/tap"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rbTimerMode"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="12dp"
                            android:buttonTint="@color/primary"
                            android:gravity="center_vertical"
                            android:text="@string/timer"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                    </RadioGroup>

                    <LinearLayout
                        android:id="@+id/layoutTimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_surface_rounded_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/rgCompleteMode">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilTimer"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:hint="@string/minutes"
                            app:boxBackgroundColor="@color/text_field_bg"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/text_field_box_stroke"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeWidthFocused="2dp"
                            app:hintTextColor="@color/text_field_box_stroke">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtTimer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_disabled"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_section_rounded_12"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvRewardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/title_reward"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:paddingVertical="4dp"
                        app:layout_constraintEnd_toStartOf="@id/btnRewardQuestion"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageButton
                        android:id="@+id/btnRewardQuestion"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="2dp"
                        android:background="@drawable/bg_light_blue_circle"
                        android:contentDescription="@string/btn_reward_question"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_question_solid_full"
                        app:layout_constraintBottom_toBottomOf="@id/tvRewardTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvRewardTitle"
                        app:tint="@color/on_primary" />

                    <View
                        android:id="@+id/rewardDivider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/divider"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvRewardTitle" />

                    <TextView
                        android:id="@+id/tvCoin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="6dp"
                        android:includeFontPadding="false"
                        android:text="@string/title_reward_coins"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toStartOf="@id/tvExp"
                        app:layout_constraintHorizontal_chainStyle="spread"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/rewardDivider" />

                    <TextView
                        android:id="@+id/tvExp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:text="@string/title_experience_reward"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvCoin"
                        app:layout_constraintTop_toTopOf="@id/tvCoin" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCoin"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/not_set"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        app:backgroundTint="@color/primary_container"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_coins_solid_full"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/primary"
                        app:layout_constraintEnd_toStartOf="@id/btnExp"
                        app:layout_constraintHorizontal_chainStyle="spread"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvCoin"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExp"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/not_set"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        app:backgroundTint="@color/primary_container"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_arrow_turn_up_solid_full"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/primary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/btnCoin"
                        app:layout_constraintTop_toTopOf="@id/btnCoin"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1dp" />

                    <TextView
                        android:id="@+id/tvItem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:includeFontPadding="false"
                        android:text="@string/title_item_reward"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btnCoin" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnItem"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/not_set"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        app:backgroundTint="@color/primary_container"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_gift_solid_full"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/primary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvItem"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvItems"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="true"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        app:layout_constrainedHeight="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_max="150dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btnItem"
                        tools:listitem="@layout/item_task_form_reward" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_section_rounded_12"
                    android:padding="12dp"
                    android:layout_margin="8dp"
                    android:visibility="gone"
                    >
                    <TextView
                        android:id="@+id/tvOrderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_order"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                    <ImageButton
                        android:id="@+id/btnOrderQuestion"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:padding="2dp"
                        android:src="@drawable/ic_question_solid_full"
                        android:scaleType="centerInside"
                        app:tint="@color/on_primary"
                        android:background="@drawable/bg_light_blue_circle"
                        android:contentDescription="@string/btn_order_question"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:ignore="TouchTargetSizeCheck"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTaskPenalty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="52dp"
                        android:minHeight="36dp"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/btn_penalty"
                        android:textSize="12sp"
